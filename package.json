{
  "name": "codice-fiscale-ts",
  "version": "0.0.0-development",
  "description": "A TypeScript library for calculating, validating, and decoding Italian Fiscal Codes (Codice Fiscale)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.mts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.cts",
        "default": "./build/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "files": [
    "build"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "Alessandro Amella",
  "homepage": "https://github.com/alessandroamella/codice-fiscale-ts#readme",
  "bugs": {
    "url": "https://github.com/alessandroamella/codice-fiscale-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alessandroamella/codice-fiscale-ts.git"
  },
  "keywords": [
    "codice-fiscale",
    "fiscal-code",
    "italy",
    "italian",
    "typescript",
    "validation"
  ],
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": ">=1.3.0",
      "onFail": "warn"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf build coverage",
    "type:check": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "update-municipalities": "bun scripts/update-municipalities.ts",
    "commit-municipalities-update": "bun scripts/commit-municipalities-update.ts",
    "update-and-commit": "bun run update-municipalities && bun run commit-municipalities-update",
    "cz": "cz",
    "semantic-release": "semantic-release",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "2.5.15",
    "@ryansonshine/commitizen": "^4.2.8",
    "@ryansonshine/cz-conventional-changelog": "^3.3.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/bun": "^1.4.3",
    "husky": "^9.1.7",
    "publint": "^0.3.25",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.23.1",
    "typescript": "~5.9.3"
  }
}
