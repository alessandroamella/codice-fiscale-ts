{
  "name": "codice-fiscale-ts",
  "version": "0.0.0-development",
  "description": "A TypeScript library for calculating, validating, and decoding Italian Fiscal Codes (Codice Fiscale)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.ts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.cts",
        "default": "./build/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.ts",
  "files": [
    "build"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "Alessandro Amella",
  "homepage": "https://github.com/alessandroamella/codice-fiscale-ts#readme",
  "bugs": {
    "url": "https://github.com/alessandroamella/codice-fiscale-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alessandroamella/codice-fiscale-ts.git"
  },
  "keywords": [
    "codice-fiscale",
    "fiscal-code",
    "italy",
    "italian",
    "typescript",
    "validation"
  ],
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.10.0",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@12.3.4",
  "volta": {
    "node": "24.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning --experimental-strip-types  ./scripts/build.ts",
    "clean": "rimraf build coverage",
    "type:check": "tsc --noEmit",
    "lint": "biome check --error-on-warnings ./src ./scripts",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types ./scripts/test.ts test",
    "test:watch": "node --disable-warning=ExperimentalWarning --experimental-strip-types ./scripts/test.ts test:watch",
    "test:coverage": "node --disable-warning=ExperimentalWarning --experimental-strip-types ./scripts/test.ts test:coverage",
    "update-municipalities": "node --disable-warning=ExperimentalWarning --experimental-strip-types ./scripts/update-municipalities.ts",
    "commit-municipalities-update": "node --disable-warning=ExperimentalWarning --experimental-strip-types ./scripts/commit-municipalities-update.ts",
    "update-and-commit": "pnpm run update-municipalities && pnpm run commit-municipalities-update",
    "cz": "cz",
    "semantic-release": "semantic-release",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@microsoft/api-extractor": "^7.59.4",
    "@ryansonshine/commitizen": "^4.2.8",
    "@ryansonshine/cz-conventional-changelog": "^3.3.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.19.2",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "typescript": "~5.9.3"
  }
}
